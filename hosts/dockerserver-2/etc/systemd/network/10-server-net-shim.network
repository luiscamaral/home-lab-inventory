[Match]
Name=server-net-shim

[Network]
# .62 = top of the docker-servers-net /26 (docker auto-assigns low-first from
# 192.168.59.0/26, so the top is safe from a future IPAM collision). Moved off
# .46 on 2026-07-01: that collided with the otel-collector container on dm
# (docker IPAM is per-host and blind to this systemd-networkd shim — see memory
# feedback_macvlan_ip_collisions). ds-1's shim .33 has the same class of
# collision (vs dm watchtower) — tracked separately.
Address=192.168.59.62/32

[Route]
Destination=192.168.59.0/26
Scope=link
