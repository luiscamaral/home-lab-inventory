[Match]
Name=ens19

[Network]
Address=192.168.48.44/20
Gateway=192.168.48.1
# DNS resilience (incident 2026-06-28): pfSense primary + pihole backups.
# This file wins over the netplan-generated one (lower filename sort), so DNS
# MUST live here, not in netplan. Only .59.50 (pihole-2, same /20) stays
# L2-reachable during a pfSense/ix0 trunk outage; .100.254 routes via pfSense,
# so it is normal-op redundancy only, not outage-resilient.
DNS=192.168.48.1
DNS=192.168.59.50
DNS=192.168.100.254
Domains=home.lcamaral.com
MACVLAN=server-net-shim
