#cloud-config
# VyOS inter-segment router for the Talos lab cluster — rendered by terraform/lab-network.
#
# ⚠️ VERIFY ON FIRST BOOT: command CONTENT is from the design contract, but VyOS config SYNTAX
# evolves across rolling builds. Confirm each `set` against the actual image (esp. firewall zones,
# DHCP subnet-id, and `protocols bgp system-as`) before relying on it. Apply needs a write-capable
# Proxmox token (see README); until then this renders at `terraform plan` only.
vyos_config_commands:
  # ── system + NTP (etcd needs clean time on the isolated cluster segment) ──
  - set system host-name 'vyos-lab'
  - set service ssh port '22'
  - set service ntp server '${ntp_upstream}'
  - set service ntp allow-client address '${cluster_cidr}'

  # ── interfaces: eth0..eth3 = cluster, svr, home, lab ──
  - set interfaces ethernet eth0 description 'CLUSTER'
  - set interfaces ethernet eth0 address '${legs.cluster.address}'
  - set interfaces ethernet eth0 mtu '${legs.cluster.mtu}'
  - set interfaces ethernet eth1 description 'SVR'
  - set interfaces ethernet eth1 address '${legs.svr.address}'
  - set interfaces ethernet eth2 description 'HOME'
  - set interfaces ethernet eth2 address '${legs.home.address}'
  - set interfaces ethernet eth2 mtu '${legs.home.mtu}'
  - set interfaces ethernet eth3 description 'LAB'
  - set interfaces ethernet eth3 address '${legs.lab.address}'

  # ── default route to the internet via pfSense (SVR leg) ──
  - set protocols static route '0.0.0.0/0' next-hop '${pfsense_peer_ip}'

  # ── BGP: eBGP to pfSense + iBGP-style peering to the cluster nodes (Cilium) ──
  - set protocols bgp system-as '${asn.vyos}'
  - set protocols bgp parameters router-id '${split("/", legs.cluster.address)[0]}'
  - set protocols bgp neighbor '${pfsense_peer_ip}' remote-as '${asn.pfsense}'
  - set protocols bgp neighbor '${pfsense_peer_ip}' address-family ipv4-unicast
  - set protocols bgp address-family ipv4-unicast aggregate-address '10.244.0.0/16' summary-only
  - set protocols bgp address-family ipv4-unicast network '${cluster_cidr}'
  - set protocols bgp address-family ipv4-unicast network '${lb_pool_cidr}'
  - set protocols bgp peer-group CLUSTER remote-as '${asn.cluster}'
  - set protocols bgp peer-group CLUSTER address-family ipv4-unicast
%{ for mac, ip in node_reservations ~}
  - set protocols bgp neighbor '${ip}' peer-group 'CLUSTER'
%{ endfor ~}

  # ── DHCP on the cluster segment (Talos maintenance-mode bring-up; MAC→final-IP reservations) ──
  - set service dhcp-server shared-network-name CLUSTER subnet '${cluster_cidr}' subnet-id '1'
  - set service dhcp-server shared-network-name CLUSTER subnet '${cluster_cidr}' option default-router '${split("/", legs.cluster.address)[0]}'
%{ for mac, ip in node_reservations ~}
  - set service dhcp-server shared-network-name CLUSTER subnet '${cluster_cidr}' static-mapping 'n${replace(ip, "192.168.30.", "")}' mac '${mac}'
  - set service dhcp-server shared-network-name CLUSTER subnet '${cluster_cidr}' static-mapping 'n${replace(ip, "192.168.30.", "")}' ip-address '${ip}'
%{ endfor ~}

  # ── inbound edge: DNAT :443/:80 (on SVR leg) → Cilium Gateway LB IP ──
  - set nat destination rule 10 inbound-interface name 'eth1'
  - set nat destination rule 10 protocol 'tcp'
  - set nat destination rule 10 destination port '443'
  - set nat destination rule 10 translation address '${gateway_lb_ip}'
  - set nat destination rule 20 inbound-interface name 'eth1'
  - set nat destination rule 20 protocol 'tcp'
  - set nat destination rule 20 destination port '80'
  - set nat destination rule 20 translation address '${gateway_lb_ip}'

  # ── MSS clamp at the HOME jumbo(9000)→cluster(1500) boundary ──
  - set policy route MSS-CLAMP rule 10 protocol 'tcp'
  - set policy route MSS-CLAMP rule 10 tcp flags 'syn'
  - set policy route MSS-CLAMP rule 10 set tcp-mss '1460'
  - set interfaces ethernet eth2 policy route 'MSS-CLAMP'

  # ── TODO (tighten on the live router): zone-based firewall, default-drop, per the matrix in
  #    docs/superpowers/specs/2026-06-15-lab-network-vyos-design.md §4.2:
  #      CLUSTER→SVR: Vault :8201, MinIO :9000, registry :443, Prometheus/Thanos
  #      CLUSTER→LAB: Pi-hole :53, NAS NFS :2049 ; CLUSTER→HOME: drop
  #      SVR→CLUSTER: Prometheus scrape + kube-API :6443 ; HOME→CLUSTER: LB IP :443/:80 only
  #    VyOS 1.4+ uses `set firewall zone <Z>` + `set firewall ipv4 name <R>` — verify syntax first.
