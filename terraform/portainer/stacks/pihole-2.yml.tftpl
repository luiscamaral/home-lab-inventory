name: pihole-2

# pihole-2 — second of three pihole instances for Pattern B HA migration
# Runs on dockerserver-1 in docker-servers-net macvlan
# Authoritative records for d.lcamaral.com injected via docker compose
# `configs:` from the single source of truth at
# pihole/dnsmasq.d/04-d-lcamaral-com.conf — interpolated by terraform
# templatefile() at apply time. Stack re-deploys whenever the file changes.

networks:
  servers-net:
    name: docker-servers-net
    external: true

configs:
  dlc_zone:
    content: |
      ${indent(6, dnsmasq_content)}
  home_zone:
    content: |
      ${indent(6, home_content)}
  host_overrides:
    content: |
      ${indent(6, host_overrides_content)}

volumes:
  pihole-2-etc:
    name: pihole-2-etc

services:
  pihole:
    image: pihole/pihole:2026.06.0
    hostname: pihole-2
    networks:
      servers-net:
        ipv4_address: 192.168.59.50
    dns:
      - 192.168.48.1
      - 1.1.1.1
    environment:
      TZ: America/Denver
      FTLCONF_webserver_api_password: $${WEBPASSWORD}
      FTLCONF_dns_upstreams: 192.168.4.1
      # Forward private-range reverse (PTR) lookups to Unbound instead of
      # NXDOMAIN-ing them locally (v6 default is true). Upstream is our own
      # authoritative pfSense Unbound, so this is safe and required for
      # reverse resolution of static DHCP mappings.
      FTLCONF_dns_bogusPriv: "false"
      FTLCONF_misc_etc_dnsmasq_d: "true"
      FTLCONF_misc_check_load: "false"
      FTLCONF_resolver_resolveIPv6: "false"
      FTLCONF_ntp_sync_active: "false"
      FTLCONF_dns_listeningMode: "all"
    # /etc/pihole on a LOCAL Docker volume (not NFS). pihole-FTL keeps its
    # gravity.db / pihole-FTL.db here as SQLite; on the previous NFS bind it
    # wedged in nfs_wait_bit_killable whenever tnas stopped responding
    # (incident 2026-06-27), which is what took this instance down. Local
    # storage makes it NFS-independent — matching pihole-3's NAS-local volume.
    # orbital-sync (primary pihole-1) repopulates gravity/adlists.
    volumes:
      - pihole-2-etc:/etc/pihole
    configs:
      - source: dlc_zone
        target: /etc/dnsmasq.d/04-d-lcamaral-com.conf
        mode: 0644
      - source: home_zone
        target: /etc/dnsmasq.d/05-home.conf
        mode: 0644
      - source: host_overrides
        target: /etc/dnsmasq.d/06-host-overrides.conf
        mode: 0644
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "dig", "+short", "+tries=1", "+time=2", "@127.0.0.1", "pi.hole"]
      interval: 30s
      timeout: 5s
      retries: 3
    labels:
      loki.logging: "true"
      com.centurylinklabs.watchtower.enable: "false"
      com.docker.stack: "pihole-2"
      com.docker.service: "pihole"
      portainer.autodeploy: "false"
