name: zot

# Zot OCI registry: hosts homelab images (homelab/*) and acts as an
# on-demand pull-through cache for docker.io, ghcr.io, quay.io,
# registry.k8s.io and gcr.io (each under its own path prefix, e.g.
# zot.d.lcamaral.com/docker.io/library/nginx:1.27). Config lives in
# stacks/zot-config.json and is rendered via Compose `configs:`.
#
# Replaces the registry:2 `docker-registry` stack, which stays running
# during the cool-off period (see docs/zot-registry.md).
#
# htpasswd: the zot image is distroless (no shell), so the registry:2
# entrypoint shim can't be reused. A one-shot busybox init container
# writes the Vault-sourced htpasswd (passed via env, the path that
# survives Compose `$` interpolation for bcrypt hashes) into the
# `zot-auth` volume, then zot starts. The file is regenerated on every
# deploy, so the volume holds no persistent data.
#
# SSO: the same init container also writes the OIDC credentialsFile and the
# session cookie keys (all from Vault, passed via env; hex values, no `$`).
# zot signs users in through the Keycloak `zot` client (terraform/portainer/
# keycloak.tf); members of the Keycloak group `zot-admins` are zot admins.
# `admin` (htpasswd) stays as break-glass. See docs/zot-registry.md.

networks:
  rproxy:
    name: rproxy
    external: true
  servers-net:
    name: docker-servers-net
    external: true

volumes:
  zot-auth:
  # Default storage root on the dockermaster LOCAL disk: it holds zot's BoltDB metadata
  # (meta.db), the login sessions and no images. BoltDB is mmap'd and single-writer and does
  # not tolerate an NFS stall (2026-11-11: EIO on a write after `nfs: server not responding`
  # broke the OIDC login until a restart). Images stay on the NAS (stores below). Persistent:
  # back it up (docs/zot-registry.md), do not delete it.
  zot-meta:

configs:
  zot_config:
    content: |
      ${indent(6, replace(zot_config, "$", "$$"))}

services:
  zot-auth-init:
    image: busybox:1.37.0
    container_name: zot-auth-init
    network_mode: none
    environment:
      HTPASSWD_CONTENT: "${replace(htpasswd, "$", "$$")}"
      OIDC_CLIENT_ID: "${oidc_client_id}"
      OIDC_CLIENT_SECRET: "${replace(oidc_client_secret, "$", "$$")}"
      SESSION_HASH_KEY: "${replace(session_hash_key, "$", "$$")}"
      SESSION_ENCRYPT_KEY: "${replace(session_encrypt_key, "$", "$$")}"
    command:
      - /bin/sh
      - -c
      - |
        umask 077 && \
        printf '%s\n' "$$HTPASSWD_CONTENT" > /auth/htpasswd && \
        printf '{"clientid":"%s","clientsecret":"%s"}\n' "$$OIDC_CLIENT_ID" "$$OIDC_CLIENT_SECRET" > /auth/oidc-credentials.json && \
        printf '{"hashKey":"%s","encryptKey":"%s"}\n' "$$SESSION_HASH_KEY" "$$SESSION_ENCRYPT_KEY" > /auth/session-keys.json && \
        chmod 0600 /auth/htpasswd /auth/oidc-credentials.json /auth/session-keys.json && \
        if [ ! -e /meta/meta.db ] && [ -f /old-data/meta.db ]; then \
          echo "first start on the local volume: seeding meta.db from the old NFS root" && \
          cp -p /old-data/meta.db /meta/meta.db && \
          { [ ! -d /old-data/_sessions ] || cp -pR /old-data/_sessions /meta/_sessions; } && \
          { [ ! -f /old-data/_restore_complete ] || cp -p /old-data/_restore_complete /meta/_restore_complete; }; \
        fi
    volumes:
      - zot-auth:/auth
      # One-time migration of the metadata DB (docs/zot-registry.md, "Storage layout"): copies
      # meta.db and the sessions from the old NFS root to the local volume ONLY when the local
      # volume has no meta.db yet. The old root is read-only here and keeps its copy; remove this
      # mount and the seeding step once the migration is verified and the old copy is archived.
      - zot-meta:/meta
      - /nfs/dockermaster/docker/zot/data:/old-data:ro
    restart: "no"
    labels:
      com.docker.stack: "zot"

  zot:
    image: ghcr.io/project-zot/zot:v2.1.22
    container_name: zot
    hostname: zot
    depends_on:
      zot-auth-init:
        condition: service_completed_successfully
    networks:
      rproxy:
      servers-net:
        ipv4_address: 192.168.59.5
    expose:
      - 5000
    # OIDC issuer host. Keycloak's issuer is https://auth.cf.lcamaral.com/...
    # (fixed frontend URL), and zot panics at startup if discovery fails, so
    # keep zot off Cloudflare: resolve it to the 3 rproxy replicas (LE
    # cert for the cf names, see docs/zot-registry.md). Same name, 3 lines in
    # /etc/hosts: Go's resolver returns them in this order and the dialer
    # falls through to the next on connect failure. Browsers are unaffected.
    extra_hosts:
      - "auth.cf.lcamaral.com:192.168.59.28"
      - "auth.cf.lcamaral.com:192.168.59.48"
      - "auth.cf.lcamaral.com:192.168.59.49"
    volumes:
      # default root: local disk (meta.db, _sessions), no images
      - zot-meta:/var/lib/registry
      # images: one NFS root per route prefix (zot `storage.subPaths`); a substore stores a repo at
      # <root>/<full repo name>, e.g. stores/docker.io/docker.io/library/alpine
      - /nfs/dockermaster/docker/zot/stores/homelab:/var/lib/zot-stores/homelab
      - /nfs/dockermaster/docker/zot/stores/docker.io:/var/lib/zot-stores/docker.io
      - /nfs/dockermaster/docker/zot/stores/ghcr.io:/var/lib/zot-stores/ghcr.io
      - /nfs/dockermaster/docker/zot/stores/quay.io:/var/lib/zot-stores/quay.io
      - /nfs/dockermaster/docker/zot/stores/registry.k8s.io:/var/lib/zot-stores/registry.k8s.io
      - /nfs/dockermaster/docker/zot/stores/gcr.io:/var/lib/zot-stores/gcr.io
      - zot-auth:/etc/zot/auth:ro
    configs:
      - source: zot_config
        target: /etc/zot/config.json
        mode: 0444
    restart: unless-stopped
    # Distroless image ships no HEALTHCHECK; the binary has a built-in
    # probe (GET /readyz on the configured listener, exit 0 on 2xx).
    healthcheck:
      test: ["CMD", "/usr/local/bin/zot-linux-amd64", "healthcheck", "/etc/zot/config.json"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 20s
    labels:
      com.docker.stack: "zot"
      com.docker.service: "zot"
      portainer.autodeploy: "false"
    deploy:
      resources:
        limits:
          cpus: '2'
          memory: 1G
        reservations:
          cpus: '0.25'
          memory: 128M
