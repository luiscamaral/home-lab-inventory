{
  "distSpecVersion": "1.1.1",
  "storage": {
    "rootDirectory": "/var/lib/registry",
    "dedupe": false,
    "gc": true,
    "gcDelay": "1h",
    "gcInterval": "24h",
    "retention": {
      "delay": "24h",
      "policies": [
        {
          "repositories": [
            "docker.io/**",
            "ghcr.io/**",
            "quay.io/**",
            "registry.k8s.io/**",
            "gcr.io/**"
          ],
          "deleteReferrers": true,
          "deleteUntagged": true,
          "keepTags": [
            {
              "pulledWithin": "2160h"
            }
          ]
        }
      ]
    }
  },
  "http": {
    "address": "0.0.0.0",
    "port": "5000",
    "realm": "zot",
    "compat": [
      "docker2s2"
    ],
    "auth": {
      "htpasswd": {
        "path": "/etc/zot/auth/htpasswd"
      },
      "failDelay": 5
    },
    "accessControl": {
      "metrics": {
        "anonymousPolicy": [
          "read"
        ]
      },
      "repositories": {
        "**": {
          "anonymousPolicy": [
            "read"
          ],
          "defaultPolicy": [
            "read"
          ]
        },
        "homelab/**": {
          "anonymousPolicy": [],
          "defaultPolicy": [
            "read"
          ]
        }
      },
      "adminPolicy": {
        "users": [
          "admin"
        ],
        "actions": [
          "read",
          "create",
          "update",
          "delete"
        ]
      }
    }
  },
  "log": {
    "level": "info"
  },
  "extensions": {
    "sync": {
      "enable": true,
      "registries": [
        {
          "urls": [
            "https://index.docker.io"
          ],
          "content": [
            {
              "prefix": "**",
              "destination": "/docker.io"
            }
          ],
          "onDemand": true,
          "tlsVerify": true,
          "maxRetries": 3,
          "retryDelay": "10s",
          "syncTimeout": "15m"
        },
        {
          "urls": [
            "https://ghcr.io"
          ],
          "content": [
            {
              "prefix": "**",
              "destination": "/ghcr.io"
            }
          ],
          "onDemand": true,
          "tlsVerify": true,
          "maxRetries": 3,
          "retryDelay": "10s",
          "syncTimeout": "15m"
        },
        {
          "urls": [
            "https://quay.io"
          ],
          "content": [
            {
              "prefix": "**",
              "destination": "/quay.io"
            }
          ],
          "onDemand": true,
          "tlsVerify": true,
          "maxRetries": 3,
          "retryDelay": "10s",
          "syncTimeout": "15m"
        },
        {
          "urls": [
            "https://registry.k8s.io"
          ],
          "content": [
            {
              "prefix": "**",
              "destination": "/registry.k8s.io"
            }
          ],
          "onDemand": true,
          "tlsVerify": true,
          "maxRetries": 3,
          "retryDelay": "10s",
          "syncTimeout": "15m"
        },
        {
          "urls": [
            "https://gcr.io"
          ],
          "content": [
            {
              "prefix": "**",
              "destination": "/gcr.io"
            }
          ],
          "onDemand": true,
          "tlsVerify": true,
          "maxRetries": 3,
          "retryDelay": "10s",
          "syncTimeout": "15m"
        }
      ]
    },
    "search": {
      "enable": true
    },
    "ui": {
      "enable": true
    },
    "metrics": {
      "enable": true,
      "prometheus": {
        "path": "/metrics"
      }
    },
    "scrub": {
      "enable": true,
      "interval": "24h"
    }
  }
}
