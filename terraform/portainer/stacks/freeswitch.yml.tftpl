name: freeswitch

networks:
  servers-net:
    name: docker-servers-net
    external: true

services:
  freeswitch:
    # Pinned 2026-11-27: same digest as before; the compromise lived in the container layer, not the image.
    image: ghcr.io/patrickbaus/freeswitch-docker@sha256:9fae8124caa79d3436e3622ad572f25f9091196949a90c3468af662a0755bfcc
    container_name: freeswitch
    hostname: freeswitch
    networks:
      servers-net:
        ipv4_address: 192.168.59.40
    cap_add:
      - SYS_NICE
    volumes:
      - /nfs/dockermaster/docker/freeswitch/config:/etc/freeswitch
      - /nfs/dockermaster/docker/freeswitch/logs:/var/log/freeswitch
    # Repo-managed files (terraform/portainer/stacks/freeswitch/), rendered with secrets from Vault
    # secret/homelab/freeswitch. They replace the NFS copies, which hold the old, exposed secrets.
    configs:
%{ for name, _ in fs_files ~}
      - source: fs_${replace(replace(name, "/", "_"), ".", "_")}
        target: /etc/freeswitch/${name}
        mode: 0644
%{ endfor ~}
    environment:
      ESL_PASSWORD: $${ESL_PASSWORD}
    restart: unless-stopped
    # The upstream image bakes in a HEALTHCHECK that runs
    # `fs_cli -x status` with no password flag (defaults to ClueCon).
    # This homelab uses a rotated ESL password, so the baked-in probe
    # has been failing forever and flagged the container as unhealthy
    # despite FreeSWITCH being fully functional. Override the image
    # healthcheck with a working one that passes the real password.
    healthcheck:
      test: ["CMD-SHELL", "fs_cli -p $$ESL_PASSWORD -x status | grep -q ^UP"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 30s
    labels:
      com.centurylinklabs.watchtower.enable: "false"
      com.docker.stack: "freeswitch"
      com.docker.service: "freeswitch"
      portainer.autodeploy: "false"
    deploy:
      resources:
        limits:
          cpus: '2'
          memory: 2G
        reservations:
          cpus: '0.5'
          memory: 512M

configs:
%{ for name, content in fs_files ~}
  fs_${replace(replace(name, "/", "_"), ".", "_")}:
    content: |
      ${indent(6, replace(content, "$", "$$"))}
%{ endfor ~}
