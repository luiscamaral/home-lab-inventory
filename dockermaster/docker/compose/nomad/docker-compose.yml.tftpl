# Project NOMAD + embeddings Ollama + LiteLLM router — dockerserver-2
# Spec: docs/superpowers/specs/2026-11-13-project-nomad-deployment-design.md
# Managed by Terraform (terraform/portainer/stacks.tf -> portainer_stack.nomad).
#
# nomad_admin drives the host Docker daemon through the socket and spawns its
# own children (qdrant, kiwix, ...). Two names are load-bearing and must not
# change: the container name `nomad_admin` and the network `project-nomad_default`.
name: project-nomad

configs:
  litellm_config:
    content: |
      ${indent(6, litellm_config)}

services:
  admin:
    image: ghcr.io/crosstalk-solutions/project-nomad:v1.35.1
    container_name: nomad_admin
    restart: unless-stopped
    extra_hosts:
      - "host.docker.internal:host-gateway"
    volumes:
      - /nfs/dockermaster/nomad/storage:/app/storage
      - /var/run/docker.sock:/var/run/docker.sock
    environment:
      - NODE_ENV=production
      - NOMAD_STORAGE_PATH=/nfs/dockermaster/nomad/storage
      - PORT=8080
      - LOG_LEVEL=info
      - APP_KEY=$${NOMAD_APP_KEY}
      - HOST=0.0.0.0
      - URL=https://nomad.d.lcamaral.com
      - DB_HOST=mysql
      - DB_PORT=3306
      - DB_DATABASE=nomad
      - DB_USER=nomad_user
      - DB_PASSWORD=$${NOMAD_DB_PASSWORD}
      - DB_NAME=nomad
      - DB_SSL=false
      - REDIS_HOST=redis
      - REDIS_PORT=6379
      - DISABLE_COMPRESSION=false
    depends_on:
      mysql:
        condition: service_healthy
      redis:
        condition: service_healthy
    networks:
      servers-net:
        ipv4_address: 192.168.59.60
      default:
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8080/api/health"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 60s
    labels:
      loki.logging: "true"
      com.centurylinklabs.watchtower.enable: "false"
      com.docker.stack: "nomad"
      com.docker.service: "nomad-admin"
      portainer.autodeploy: "false"

  mysql:
    image: mysql:8.0
    container_name: nomad_mysql
    restart: unless-stopped
    environment:
      - MYSQL_ROOT_PASSWORD=$${NOMAD_MYSQL_ROOT_PASSWORD}
      - MYSQL_DATABASE=nomad
      - MYSQL_USER=nomad_user
      - MYSQL_PASSWORD=$${NOMAD_DB_PASSWORD}
    volumes:
      - /opt/project-nomad/mysql:/var/lib/mysql
    networks:
      - default
    healthcheck:
      test: ["CMD", "mysqladmin", "ping", "-h", "localhost"]
      interval: 30s
      timeout: 10s
      retries: 10
    labels:
      loki.logging: "true"
      com.centurylinklabs.watchtower.enable: "false"
      com.docker.stack: "nomad"
      com.docker.service: "nomad-mysql"
      portainer.autodeploy: "false"

  redis:
    image: redis:7-alpine
    container_name: nomad_redis
    restart: unless-stopped
    volumes:
      - /opt/project-nomad/redis:/data
    networks:
      - default
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 30s
      timeout: 10s
      retries: 3
    labels:
      loki.logging: "true"
      com.centurylinklabs.watchtower.enable: "false"
      com.docker.stack: "nomad"
      com.docker.service: "nomad-redis"
      portainer.autodeploy: "false"

  disk-collector:
    image: ghcr.io/crosstalk-solutions/project-nomad-disk-collector:v1.31.1
    container_name: nomad_disk_collector
    restart: unless-stopped
    volumes:
      - /:/host:ro,rslave
      - /nfs/dockermaster/nomad/storage:/storage
    networks:
      - default
    labels:
      loki.logging: "true"
      com.centurylinklabs.watchtower.enable: "false"
      com.docker.stack: "nomad"
      com.docker.service: "nomad-disk-collector"
      portainer.autodeploy: "false"

  # Embeddings only. NOMAD hardcodes nomic-embed-text:v1.5 (768-dim) for its
  # Qdrant knowledge base; chat goes to external providers via litellm.
  # Deliberately NOT named nomad_ollama so NOMAD's own AI installer never
  # mistakes it for the service it manages.
  ollama:
    image: ollama/ollama:0.40.16
    container_name: nomad_embed_ollama
    restart: unless-stopped
    environment:
      - OLLAMA_HOST=0.0.0.0:11434
      - OLLAMA_KEEP_ALIVE=30m
      - OLLAMA_MAX_LOADED_MODELS=1
    volumes:
      - /opt/project-nomad/ollama:/root/.ollama
    networks:
      - default
    healthcheck:
      test: ["CMD-SHELL", "ollama list > /dev/null"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 60s
    deploy:
      resources:
        limits:
          cpus: "4"
          memory: 3G
    labels:
      loki.logging: "true"
      com.centurylinklabs.watchtower.enable: "false"
      com.docker.stack: "nomad"
      com.docker.service: "nomad-embed-ollama"
      portainer.autodeploy: "false"

  litellm:
    image: ghcr.io/berriai/litellm:v1.108.8
    container_name: nomad_litellm
    restart: unless-stopped
    command: ["--config", "/etc/litellm/config.yaml", "--port", "4000"]
    configs:
      - source: litellm_config
        target: /etc/litellm/config.yaml
    environment:
      - OPENROUTER_API_KEY=$${OPENROUTER_API_KEY}
      - LITELLM_LOG=INFO
    depends_on:
      ollama:
        condition: service_healthy
    networks:
      - default
    healthcheck:
      test: ["CMD-SHELL", "python3 -c \"import urllib.request; urllib.request.urlopen('http://localhost:4000/health/liveliness', timeout=3)\""]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 40s
    labels:
      loki.logging: "true"
      com.centurylinklabs.watchtower.enable: "false"
      com.docker.stack: "nomad"
      com.docker.service: "nomad-litellm"
      portainer.autodeploy: "false"

networks:
  servers-net:
    external: true
    name: docker-servers-net
  default:
    name: project-nomad_default
    driver: bridge
